{
  "name": "@go-/cli",
  "version": "0.1.0",
  "description": "CLI go- : initialiser, générer, construire, tester et lancer des projets GO-",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/__tests__",
    "!dist/**/*.tsbuildinfo"
  ],
  "sideEffects": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Alexiskd/Go-.git",
    "directory": "tools/cli"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@go-/types": "^0.1.0",
    "@go-/shared": "^0.1.0",
    "@go-/contracts": "^0.1.0",
    "@go-/generators": "^0.1.0"
  },
  "bin": {
    "go-": "./dist/bin.js"
  }
}
