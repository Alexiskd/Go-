{
  "name": "go-monorepo",
  "private": true,
  "description": "GO- : stack full-stack TypeScript (Node.js, NestJS, Next.js, React, Angular)",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "packages/*",
    "tools/*",
    "apps/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "typecheck": "tsc -b --noEmit false",
    "test": "node --test --test-reporter=spec \"packages/*/dist/__tests__/*.test.js\" \"tools/*/dist/__tests__/*.test.js\" \"apps/*/dist/__tests__/*.test.js\"",
    "check": "npm run build && npm test",
    "go-": "node tools/cli/dist/bin.js",
    "bench": "node tools/scripts/bench.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^7.0.2"
  }
}
