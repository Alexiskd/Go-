# Copier en .env puis adapter. Préfixe API_ obligatoire.
NODE_ENV=development
API_PORT=3000
API_HOST=0.0.0.0
# Générer avec : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
API_JWT_SECRET=
API_JWT_EXPIRES_IN=3600
API_CORS_ORIGINS=http://localhost:3001,http://localhost:4200
API_ADMIN_EMAIL=admin@example.com
API_ADMIN_PASSWORD=
API_PASSWORD_COST=15
API_RATE_LIMIT_PER_MINUTE=120
